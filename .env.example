# Generate a random secret: openssl rand -hex 32
MCP_AUTH_TOKEN=your-secret-token-here

# Paste the full contents of your service account JSON key (single line, no newlines)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Your GA4 property ID — numeric only (find it in GA4 Admin > Property Settings)
GA4_PROPERTY_ID=123456789

# Your GSC site URL — must match exactly what appears in Search Console
# Use https://example.com/ (with trailing slash) for URL-prefix properties
# Use sc-domain:example.com for domain properties
GSC_SITE_URL=https://example.com/
